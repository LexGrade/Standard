{
  "name": "@lexgrade/mcp",
  "version": "1.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Model Context Protocol server for the open LexGrade Standard — serves the rubric, criteria, technique register, and calibration set to Claude and other MCP clients. Reads the standard locally; no network, no account.",
  "bin": {
    "lexgrade-mcp": "index.mjs"
  },
  "main": "lib.mjs",
  "files": [
    "index.mjs",
    "lib.mjs",
    "README.md"
  ],
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test 'test/*.mjs'"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lexgrade",
    "legal",
    "standard",
    "claude"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@lexgrade/core": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  }
}
